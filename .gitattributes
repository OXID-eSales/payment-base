# Keep the composer dist package to what the shop actually runs.
# Everything below stays in the git repository but is stripped from the
# archive composer downloads (`--prefer-dist`, i.e. the default install).
# LICENSE, README.md and CHANGELOG.md are deliberately NOT ignored.

/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.gitleaks.toml     export-ignore

# Developer helper scripts. The two commands composer.json declares under "bin"
# (bin/oe-payment-base-migrate, bin/oe-payment-base-schema-check) MUST stay in the
# archive: composer links them into the shop's vendor/bin only when the files are
# there. v1.6.1 to v1.7.4 excluded the whole folder and shipped neither command
# (tests/Unit/Packaging/DistArchiveTest guards this now).
/bin/dead-assets          export-ignore
/bin/pre-commit-check.sh  export-ignore

# Generated API documentation and sprint logs.
/docs/html          export-ignore
/docs/dev_log       export-ignore

# Tests and static analysis configuration.
/tests              export-ignore
/phpunit.xml        export-ignore
/phpstan.neon       export-ignore
