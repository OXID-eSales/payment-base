includes:
    - tests/PhpStan/phpstan-baseline.neon
    - tests/PhpStan/rules.neon

parameters:
    bootstrapFiles:
        - tests/PhpStan/phpstan-bootstrap.php
    level: max
    paths:
        - src
    excludePaths:
        - tests
        - vendor
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Missing array value type in legacy code
        - '#type has no value type specified in iterable type array#'
        # Cannot cast mixed to scalar types
        - '#Cannot cast mixed to int#'
        - '#Cannot cast mixed to string#'
        - '#Cannot cast mixed to float#'
        # Parameter type mismatches from dynamic data
        - '#Parameter .* expects string, mixed given#'
        - '#Parameter .* expects int, mixed given#'
        # Method returns mixed from external calls
        - '#should return .* but returns mixed#'
        # OXID core classes not in PC's composer deps (shop context required at runtime)
        - '#Call to static method (getRequest|getSession|getLogger|getUtilsView|getConfig|getLang)\(\) on an unknown class OxidEsales\\Eshop\\Core\\Registry#'
        - '#unknown class OxidEsales\\Eshop\\Application\\(Controller|Model)\\#'
        - '#Cannot call method \w+\(\) on mixed#'
        # OXID's model factory. Wording differs between PHPStan versions.
        - '#(Used f|F)unction oxNew not found#'
