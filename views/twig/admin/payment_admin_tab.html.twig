{#  ==========================================================================
    Sprint I — shared "Payment" admin tab (payment-base).

    Controller: OxidEsales\PaymentBase\Admin\PaymentAdminController
    Controller key: PaymentAdmin

    Regression invariants (do not remove):
    - `<form id="transfer">` with `cl="PaymentAdmin"` — OXID's tab-switcher
      reads this element to navigate. Without it, the iframe dead-ends
      (2026-04-23 Task 3).
    - `bottomnaviitem.html.twig` + `bottomitem.html.twig` includes — emit
      the admin bottom nav and close `</body></html>`.

    Template variables exposed by `oView`:
    - hasProvider(): bool
    - getProviderKey(): ?string (e.g. "stripe", "paypal")
    - getPanelTemplatePath(): ?string (namespaced twig path)
    - getPanelViewData(): array
    - getOrder(): ?Order
    ========================================================================== #}

<style>
    .pc-admin,
    .pc-admin * { box-sizing: border-box !important; }
    .pc-admin {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
        font-size: 13px !important;
        color: #1a1a2e !important;
        padding: 16px !important;
        max-width: 960px !important;
        background: transparent !important;
    }
    .pc-admin h2 { font-size: 15px !important; margin: 0 0 12px 0 !important; }
    .pc-admin .pc-card {
        border: 1px solid #e5e7eb !important;
        border-radius: 6px !important;
        background: #fff !important;
        padding: 16px !important;
        margin-bottom: 16px !important;
    }
    .pc-admin .pc-alert {
        border: 1px solid transparent !important;
        border-radius: 6px !important;
        padding: 12px 14px !important;
        margin-bottom: 16px !important;
    }
    .pc-admin .pc-alert-info    { background: #eff6ff !important; border-color: #bfdbfe !important; color: #1e40af !important; }
    .pc-admin .pc-alert-success { background: #f0fdf4 !important; border-color: #bbf7d0 !important; color: #14532d !important; }
    .pc-admin .pc-alert-warning { background: #fffbeb !important; border-color: #fde68a !important; color: #92400e !important; }
    .pc-admin .pc-alert-danger  { background: #fef2f2 !important; border-color: #fecaca !important; color: #991b1b !important; }
    .pc-admin .pc-btn {
        display: inline-block !important;
        padding: 8px 14px !important;
        border-radius: 6px !important;
        border: 1px solid transparent !important;
        cursor: pointer !important;
        text-decoration: none !important;
        font-size: 13px !important;
    }
    /* Brand color is owned by each provider panel via the --pc-brand custom
       property (set on the .pc-admin[data-provider="…"] scope from the panel
       template). The base ships only a neutral fallback — it holds no PSP
       brand hex codes. */
    .pc-admin .pc-btn-primary { background: var(--pc-brand, #1a1a2e) !important; color: #fff !important; }
    .pc-admin .pc-btn-primary:hover { filter: brightness(1.12) !important; }
    .pc-admin .pc-btn-warning { background: #f59e0b !important; color: #fff !important; }
    .pc-admin .pc-btn-warning:hover { background: #d97706 !important; }
    .pc-admin .pc-btn-danger-outline { background: #fff !important; color: #dc2626 !important; border: 1px solid #fca5a5 !important; }
    .pc-admin .pc-btn-danger-outline:hover { background: #fef2f2 !important; }
    .pc-admin table { border: none !important; background: none !important; width: 100% !important; border-collapse: collapse !important; }
    .pc-admin td, .pc-admin th { border: none !important; background: none !important; padding: 4px 8px !important; text-align: left !important; }
    .pc-admin .pc-card-header { font-weight: 600 !important; font-size: 14px !important; margin: 0 0 12px 0 !important; padding-bottom: 8px !important; border-bottom: 1px solid #e5e7eb !important; }
    .pc-admin .pc-card-body { margin-top: 8px !important; }
    .pc-admin .pc-details { width: 100% !important; }
    .pc-admin .pc-details .pc-label { color: #6b7280 !important; white-space: nowrap !important; padding-right: 12px !important; vertical-align: top !important; }
    .pc-admin .pc-details .pc-value { font-weight: 500 !important; }
    .pc-admin .pc-muted { color: #6b7280 !important; }
    .pc-admin code { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace !important; background: #f3f4f6 !important; padding: 1px 6px !important; border-radius: 3px !important; font-size: 12px !important; }
    .pc-admin .pc-table { width: 100% !important; font-size: 12px !important; }
    .pc-admin .pc-table th { color: #374151 !important; font-weight: 600 !important; border-bottom: 1px solid #e5e7eb !important; }
    .pc-admin .pc-table tbody tr { border-bottom: 1px solid #f3f4f6 !important; }
    .pc-admin .pc-table .text-right { text-align: right !important; }
    .pc-admin .pc-badge { display: inline-block !important; padding: 2px 8px !important; border-radius: 10px !important; font-size: 11px !important; font-weight: 500 !important; }
    .pc-admin .pc-badge-blue   { background: #dbeafe !important; color: #1e40af !important; }
    .pc-admin .pc-badge-green  { background: #dcfce7 !important; color: #166534 !important; }
    .pc-admin .pc-badge-orange { background: #ffedd5 !important; color: #9a3412 !important; }
    .pc-admin .pc-badge-gray   { background: #f3f4f6 !important; color: #374151 !important; }
    .pc-admin .pc-empty { color: #6b7280 !important; padding: 24px 0 !important; text-align: center !important; font-style: italic !important; }
    .pc-admin .pc-form-row { display: flex !important; gap: 12px !important; flex-wrap: wrap !important; }
    .pc-admin .pc-form-group { flex: 1 1 220px !important; margin-bottom: 12px !important; }
    .pc-admin .pc-form-label { display: block !important; font-weight: 500 !important; margin-bottom: 4px !important; color: #374151 !important; }
    .pc-admin .pc-form-input,
    .pc-admin .pc-form-select { width: 100% !important; padding: 6px 10px !important; border: 1px solid #d1d5db !important; border-radius: 4px !important; font-size: 13px !important; background: #fff !important; }

    /* ==========================================================================
       Sprint 05 (2026-05-19) — busy overlay machinery (was in stripe panel).
       The shared payment-tab carries one spinner+blur overlay that PSP panels
       trigger by marking their action forms with `.js-payment-action-form`. The
       wrapper is rendered server-side with `.pc-panel-busy` so the spinner is
       visible from first paint; init() clears it on DOMContentLoaded.
       ========================================================================== */
    .pc-admin { position: relative !important; }
    .pc-admin.pc-panel-busy > *:not(.pc-spinner) {
        opacity: 0.5 !important;
        filter: blur(2px) !important;
        pointer-events: none !important;
        user-select: none !important;
    }
    .pc-admin .pc-spinner {
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        width: 48px !important;
        height: 48px !important;
        display: none !important;
        border: 4px solid #cccccc !important;
        border-top-color: #3b82f6 !important;
        border-radius: 50% !important;
        animation: pc-spin 0.8s linear infinite !important;
        outline: 0 !important;
        z-index: 10 !important;
    }
    .pc-admin.pc-panel-busy .pc-spinner { display: block !important; }
    @keyframes pc-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
</style>

<form name="transfer" id="transfer" action="{{ oViewConf.getSelfLink() }}" method="post">
    {{ oViewConf.getHiddenSid()|raw }}
    <input type="hidden" name="oxid" value="{{ oxid }}">
    <input type="hidden" name="cl" value="PaymentAdmin">
</form>

<div class="pc-admin pc-panel-busy" data-provider="{{ oView.getProviderKey() ?: 'none' }}" data-testid="payment-admin-tab" aria-busy="true">
    {# Sprint 05 — `.pc-panel-busy` is set server-side so the spinner is
       visible from first paint while the browser parses the rest of the
       panel. init() clears it on DOMContentLoaded. The same overlay is
       reused on action-form submit, on sibling list-frame click, and
       on pagehide as a safety net. #}
    <div class="pc-spinner" role="status" tabindex="-1" aria-label="Processing"></div>

    {% if oView.hasProvider() %}
        {% set panel = oView.getPanelViewData() %}
        {% include oView.getPanelTemplatePath() with panel %}
    {% else %}
        <div class="pc-alert pc-alert-info" data-testid="payment-no-provider">
            {{ translate({ ident: "PAYMENT_ADMIN_NO_PROVIDER" }) }}
        </div>
    {% endif %}
</div>

<script>
(function () {
    function enterBusy(panel) {
        if (!panel) return;
        panel.classList.add('pc-panel-busy');
        panel.setAttribute('aria-busy', 'true');
        var spinner = panel.querySelector('.pc-spinner');
        if (spinner) spinner.focus();
        setTimeout(function () {
            panel.classList.remove('pc-panel-busy');
            panel.removeAttribute('aria-busy');
        }, 30000);
    }

    function bindCrossFrameNavSpinner(panel) {
        // The panel renders inside OXID admin's `edit` frame; the order
        // list sits in the sibling `list` frame. Clicking a different
        // order there triggers a reload of THIS frame — but the round-trip
        // time is unobservable to the operator because the OLD panel stays
        // visible until the new HTML arrives. Bind a capturing click
        // listener on the list frame so we can re-enter busy state on the
        // current panel BEFORE the navigation actually replaces us. The
        // incoming new HTML carries .pc-panel-busy server-side, so the
        // spinner stays visible continuously across the navigation.
        try {
            var list = (window.parent && window.parent.frames && window.parent.frames['list'])
                ? window.parent.frames['list']
                : null;
            if (!list || !list.document) return;
            list.document.addEventListener('click', function (e) {
                var target = e.target;
                if (!target || typeof target.closest !== 'function') return;
                var trigger = target.closest('a[href], button[type="submit"], input[type="submit"]');
                if (!trigger) return;
                enterBusy(panel);
            }, true);
        } catch (err) {
            // Cross-frame access blocked (different origin, frame missing).
            // Silently no-op — the on-load busy class still covers the
            // parse window after the new HTML arrives.
        }
    }

    // Minimum time the on-load spinner stays visible after the
    // page is parsed. Below ~150ms the spinner blinks too briefly
    // for humans to perceive on fast renders — on a warm cache the
    // server response is ~30ms and DOMContentLoaded fires within
    // single-digit ms of first paint, so without this delay the
    // operator sees no feedback at all when switching from Overview
    // (or any non-Payment tab) to Payment. 200ms is the empirical
    // sweet spot between "perceptible" and "doesn't feel sluggish."
    var INITIAL_BUSY_MIN_MS = 200;

    function init() {
        var panel = document.querySelector('.pc-admin');
        if (!panel) return;

        // Clear the initial server-set busy state — but only after a
        // minimum perceptible window so the spinner is visible even on
        // fast renders. Slow renders already show the spinner for the
        // duration of the parse; this delay only stretches the
        // fast-render case enough to be seen.
        setTimeout(function () {
            panel.classList.remove('pc-panel-busy');
            panel.removeAttribute('aria-busy');
        }, INITIAL_BUSY_MIN_MS);

        // PSP-agnostic action-form hook: any panel that includes a form
        // marked `.js-payment-action-form` gets the overlay on submit.
        var forms = document.querySelectorAll('.js-payment-action-form');
        forms.forEach(function (form) {
            form.addEventListener('submit', function () { enterBusy(panel); });
        });

        // Inter-order navigation (click in sibling list frame).
        bindCrossFrameNavSpinner(panel);

        // Safety net for navigations we can't hook (URL bar, back / forward,
        // any JS-driven location change inside this frame). Fires right
        // before the page is unloaded.
        window.addEventListener('pagehide', function () { enterBusy(panel); });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>

