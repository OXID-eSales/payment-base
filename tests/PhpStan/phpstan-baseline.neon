parameters:
    ignoreErrors:
        # Sprint I: AdminActionDispatcherInterface accepts the OXID core
        # Order model directly because oxideshop_ce 7.4 doesn't ship a
        # public Order interface. Track: widen to an order interface
        # once one exists upstream.
        -
            message: '#Parameter \$order uses concrete class "OxidEsales\\Eshop\\Application\\Model\\Order" instead of an interface\.#'
            path: ../../src/Admin/Contract/AdminActionDispatcherInterface.php
            count: 3

        # Sprint E trait — consumed by PSP modules (Stripe / PayPal)
        # outside this package's scope; PHPStan can't see those
        # consumers when analysing PC standalone.
        -
            message: '#Trait OxidEsales\\PaymentBase\\Controller\\HandlesCheckoutReturn is used zero times and is not analysed\.#'
            path: ../../src/Controller/HandlesCheckoutReturn.php
            count: 1
