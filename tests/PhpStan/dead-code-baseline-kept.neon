# Kept deliberately (VR-17 DC-PB8 review of the unreviewed backlog). Remove an entry only together with the code.
# Each group below says why it stays.

parameters:
    ignoreErrors:
        # Value objects the providers construct: a constructor field nothing reads yet (removing it breaks the constructors in the providers).
        -
            message: '#^Property\ OxidEsales\\PaymentBase\\Admin\\Panel\\PaymentPanelRenderable::\$providerKey\ is\ never\ read$#'
            identifier: shipmonk.deadProperty.neverRead
            count: 1
            path: ../../src/Admin/Panel/PaymentPanelRenderable.php
        # At-risk flags: acknowledge and openForContract are the designed merchant-decision API (column OXACKNOWLEDGEDAT, covered by the integration test), no caller yet - owner decision before they go.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\DoctrinePaymentAtRiskRepository::openForContract$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/DoctrinePaymentAtRiskRepository.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskFlag::acknowledge$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskFlag.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskFlagInterface::acknowledge$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskFlagInterface.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskQueryInterface::openForContract$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskQueryInterface.php
        # Per-line VAT math (Sprint 27 RC, owner decision D1): kept as the provider-payload primitive for
        # per-line VAT (invariant I2, docs/invariants/oxid-totals-win.md). Its only production caller, the
        # PriceList override, was deleted because it rewrote OXID's totals (invariant I1). First consumer
        # to come: a shared itemisation reconciler in the provider line builders.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\PerLineVatCalculator::calculate$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/PerLineVatCalculator.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\PerLineVatCalculatorInterface::calculate$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/PerLineVatCalculatorInterface.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::toArray$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        # VatBreakdown: the result value object of the VAT calculator; the calculator's tests and any caller read it through these accessors.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::rates$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::totalVat$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        -
