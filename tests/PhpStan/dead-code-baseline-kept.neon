# Kept deliberately (VR-17 DC-PB8 review of the unreviewed backlog). Remove an entry only together with the code.
# Each group below says why it stays.

parameters:
    ignoreErrors:
        # Value objects the providers construct: a constructor field nothing reads yet (removing it breaks the constructors in the providers).
        -
            message: '#^Property\ OxidEsales\\PaymentBase\\Admin\\Panel\\PaymentPanelRenderable::\$providerKey\ is\ never\ read$#'
            identifier: shipmonk.deadProperty.neverRead
            count: 1
            path: ../../src/Admin/Panel/PaymentPanelRenderable.php
        # At-risk flags: acknowledge and openForContract are the designed merchant-decision API (column OXACKNOWLEDGEDAT, covered by the integration test), no caller yet - owner decision before they go.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\DoctrinePaymentAtRiskRepository::openForContract$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/DoctrinePaymentAtRiskRepository.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskFlag::acknowledge$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskFlag.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskFlagInterface::acknowledge$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskFlagInterface.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\AtRisk\\PaymentAtRiskQueryInterface::openForContract$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/AtRisk/PaymentAtRiskQueryInterface.php
        # VatBreakdown: the result value object of the VAT calculator; the calculator's tests and any caller read it through these accessors.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::rates$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::totalVat$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Math\\Vat\\VatBreakdown::vatForRate$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        # ReturnResolution::alreadyProcessed: factory of the ALREADY_PROCESSED outcome the return responder handles; a provider resolver builds it.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Return\\ReturnResolution::alreadyProcessed$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Return/ReturnResolution.php
        # AddressHmacService::verify: the verifying half of a signing pair (hashes are written, nothing checks them yet). Owner decision: wire the check or drop signing.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Service\\AddressHmacService::verify$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Service/AddressHmacService.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Service\\AddressHmacServiceInterface::verify$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Service/AddressHmacServiceInterface.php
        # TrustedProxySettings::clientIp: the factory of the TrustedProxyClientIp service, called by the container (services.yaml factory), invisible to the detector.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Webhook\\Guard\\TrustedProxySettings::clientIp$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Webhook/Guard/TrustedProxySettings.php
        # Used only by provider tests (not production code); removing needs those tests changed in the provider repos first.
        -
            message: '#^Property\ OxidEsales\\PaymentBase\\Admin\\Contract\\AdminActionBounds::\$available\ is\ never\ read$#'
            identifier: shipmonk.deadProperty.neverRead
            count: 1
            path: ../../src/Admin/Contract/AdminActionBounds.php
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Service\\ContractMetadataService::getDeliveryAddressHash$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Service/ContractMetadataService.php
