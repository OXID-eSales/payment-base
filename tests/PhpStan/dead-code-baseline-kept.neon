            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Math/Vat/VatBreakdown.php
        # ReturnResolution::alreadyProcessed: factory of the ALREADY_PROCESSED outcome the return responder handles; a provider resolver builds it.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Return\\ReturnResolution::alreadyProcessed$#'
            identifier: shipmonk.deadMethod
            count: 1
            path: ../../src/Return/ReturnResolution.php
        # AddressHmacService::verify: the verifying half of a signing pair (hashes are written, nothing checks them yet). Owner decision: wire the check or drop signing.
        -
            message: '#^Unused\ OxidEsales\\PaymentBase\\Service\\AddressHmacService::verify$#'
            identifier: shipmonk.deadMethod
