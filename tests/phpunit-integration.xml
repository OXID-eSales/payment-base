<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration for Integration Tests
    Run from OXID shop context with: vendor/bin/phpunit -c vendor/oxid-esales/payment-base/tests/phpunit-integration.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="bootstrap-integration.php"
         colors="true">
    <testsuites>
        <!--
            CI runs this file without naming a suite, so every suite declared here
            executes. The renderer-dependent tests therefore cannot live in a second
            suite; they have their own config file,
            tests/phpunit-integration-renderer.xml, and are excluded below.
        -->
        <testsuite name="Integration">
            <directory>Integration</directory>
            <exclude>Integration/Checkout/SinglePaymentOrderTemplateTest.php</exclude>
            <exclude>Integration/Checkout/SinglePaymentStepTemplateTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../src</directory>
        </include>
    </source>
</phpunit>
