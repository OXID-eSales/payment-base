<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration for Integration Tests
    Run from OXID shop context with: vendor/bin/phpunit -c vendor/oxid-esales/payment-base/tests/phpunit-integration.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="bootstrap-integration.php"
         colors="true">
    <testsuites>
        <!-- Default suite: everything that runs in any shop, CI included. -->
        <testsuite name="Integration">
            <directory>Integration</directory>
            <exclude>Integration/Checkout/SinglePaymentOrderTemplateTest.php</exclude>
            <exclude>Integration/Checkout/SinglePaymentStepTemplateTest.php</exclude>
        </testsuite>
        <!--
            Renderer suite: these two render the shop's real checkout templates
            through TemplateRendererBridgeInterface to prove the module's template
            overrides land in the chain. They need a shop with a usable frontend
            theme; the CI shop image has none, and its renderer answers with the
            template *name* instead of markup, so the assertions cannot hold there.
            Run explicitly against a real shop:
              vendor/bin/phpunit -c extensions/payment-base/tests/phpunit-integration.xml Integration-renderer
            The tests themselves fail loudly (not skip) if the renderer only echoes
            the name back, so this can never pass by accident.
        -->
        <testsuite name="Integration-renderer">
            <file>Integration/Checkout/SinglePaymentOrderTemplateTest.php</file>
            <file>Integration/Checkout/SinglePaymentStepTemplateTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>../src</directory>
        </include>
    </source>
</phpunit>
