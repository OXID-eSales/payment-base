<?xml version="1.0"?>
<ruleset name="Payment Component">
    <description>PHP CodeSniffer configuration for Payment Component</description>

    <!-- Use PSR-12 coding standard -->
    <rule ref="PSR12">
        <!-- Exclude underscore prefix rule - OXID framework convention -->
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
    </rule>

    <!-- Exclude vendor and other directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <!-- Do NOT add a bare */var/* pattern here. Under the Docker mount this
         module lives at /var/www/extensions/..., so */var/* matches every file,
         PHPCS scans nothing and exits 0 — a gate that always passes. It cost us
         a red CI on STRP-168. Nothing under src/ needs excluding anyway. -->
    <exclude-pattern>*/migration/*</exclude-pattern>

    <!-- Show progress -->
    <arg value="p"/>

    <!-- Use colors in output -->
    <arg name="colors"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
</ruleset>
