<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration for Unit Tests (standalone)
    These tests use only composer autoload and do NOT require shop context.

    For Integration Tests, use: tests/phpunit-integration.xml
    Integration tests require the OXID shop bootstrap for oxNew() and other shop functions.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
